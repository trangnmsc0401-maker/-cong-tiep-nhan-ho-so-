# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend.
# Các trang còn lại (Tuần 1) vẫn dùng mock data — chưa cần biến nào khác để chạy `npm run dev`.

# Gemini (Tuần 2: chatbot QnA trên trang chủ, bắt buộc để /api/chat trả lời thật)
GEMINI_API_KEY=

# Supabase (Tuần 2: lưu hội thoại chatbot; Tuần 3: database + auth cho các phần còn lại)
# SUPABASE_SECRET_KEY chỉ dùng trên server (bypass RLS) — không bao giờ lộ ra trình duyệt,
# không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
